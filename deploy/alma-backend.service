[Unit]
Description=alma.inc Django backend (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/alma-backend
EnvironmentFile=/etc/alma-backend.env
ExecStart=/opt/alma-backend/venv/bin/gunicorn alma.wsgi:application \
  --bind 127.0.0.1:8000 --workers 1 --threads 2 --timeout 30 \
  --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
