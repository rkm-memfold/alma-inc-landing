---
// The macOS desktop, shared by every route.
//
// `open` is the window this URL represents; it is marked server-side so the
// right one is showing before any JavaScript runs, and so a crawler with no
// JavaScript sees only this page's content rather than all of it at once.
interface Props {
  open?: string;
}

import { WINDOW_HTML } from "../content/windows.mjs";
import Wallpaper from "./Wallpaper.astro";

const { open = "welcome" } = Astro.props;

// Each page needs exactly one h1. Welcome, Manifesto and Join Us carry a
// heading inside the window body, so theirs stays a plain title bar; for the
// four that do not, the title bar is the page's heading when it is the route.
const DemosTitle = open === "demos" ? "h1" : "div";
const SocialsTitle = open === "socials" ? "h1" : "div";
const BlenderTitle = open === "blender" ? "h1" : "div";
const PaintTitle = open === "paint" ? "h1" : "div";
---

    <Wallpaper />
    <script is:inline>
      (() => {
        const reveal = () => document.body.classList.add("is-ready");
        // The wallpaper is an inline SVG now, and load on an SVG <image> is not
        // dependable across browsers. Racing the same URL resolves out of cache
        // the moment the real one lands, which is the event we actually wanted.
        const plate = new Image();
        plate.addEventListener("load", reveal, { once: true });
        plate.addEventListener("error", reveal, { once: true });
        plate.src = "/page/desktop/wallpaper.jpg";
        if (plate.complete) reveal();
        window.setTimeout(reveal, 4000);
      })();
    </script>

    <!-- ============================================================ -->
    <!-- Menu bar                                                      -->
    <!-- ============================================================ -->
    <header class="menubar">
      <div class="menubar-left">
        <button class="menu-title is-mark" type="button" data-menu="apple" aria-label="Alma menu" aria-haspopup="true" aria-expanded="false">
          <img src="/page/desktop/icons/menu-alma.png" alt="" width="96" height="96" fetchpriority="high">
        </button>
        <button class="menu-title is-app" type="button" data-menu="alma" aria-haspopup="true" aria-expanded="false">Alma</button>
        <button class="menu-title is-secondary" type="button" data-menu="file" aria-haspopup="true" aria-expanded="false">File</button>
        <button class="menu-title is-secondary" type="button" data-menu="view" aria-haspopup="true" aria-expanded="false">View</button>
        <button class="menu-title is-secondary" type="button" data-menu="window" aria-haspopup="true" aria-expanded="false">Window</button>
