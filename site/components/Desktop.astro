        <span class="menubar-extra" aria-hidden="true" title="Battery">
          <img src="/page/desktop/icons/menu-battery.png" alt="" width="96" height="46" style="height: 13px">
        </span>
        <button class="menubar-extra" type="button" id="prompt-trigger" title="Ask Alma" aria-label="Ask Alma">
          <img src="/page/desktop/icons/menu-search.png" alt="" width="64" height="60" style="height: 16px">
        </button>
        <span class="menubar-extra" aria-hidden="true" title="Control Centre">
          <img src="/page/desktop/icons/menu-control.png" alt="" width="64" height="58" style="height: 16px">
        </span>
