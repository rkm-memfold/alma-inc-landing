    <div class="alert-scrim" id="alert-scrim" hidden>
      <div class="alert-sheet glass" role="alertdialog" aria-modal="true" aria-labelledby="alert-title" aria-describedby="alert-body">
        <img class="alert-icon" src="/page/desktop/icons/alma.png" alt="" width="192" height="192" decoding="async">
        <p class="alert-title" id="alert-title">Alma is coming soon.</p>
        <p class="alert-body" id="alert-body">The Mac app is in private testing. Leave an email and you will be in the next round of invites.</p>
        <div class="alert-buttons">
          <button class="alert-button" type="button" data-alert-close>Not now</button>
          <button class="alert-button is-default" type="button" data-alert-waitlist>Join the waitlist</button>
