          <img src="/page/desktop/icons/alma.png" alt="Alma" width="192" height="192" decoding="async">
          <span class="dock-dot"></span>
        </button>

<span class="dock-minimised" id="dock-minimised"></span>
        <button class="dock-item" type="button" data-noop>
          <span class="dock-tip glass">Trash</span>
          <img src="/page/desktop/icons/trash.png" alt="Trash" width="192" height="192" decoding="async">
        </button>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- Agent cursor + chrome                                         -->
    <!-- ============================================================ -->
    <div class="agent-cursor" id="agent-cursor" aria-hidden="true">
      <span class="cursor-aura"></span>
      <svg class="cursor-glyph" viewBox="0 0 30 30">
        <defs>
          <linearGradient id="cursorFill" x1="6" y1="2" x2="20" y2="24" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ffffff"/>
            <stop offset="0.42" stop-color="#fff6dd"/>
            <stop offset="1" stop-color="#f0c67c"/>
          </linearGradient>
          <linearGradient id="cursorRim" x1="4" y1="2" x2="20" y2="24" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"/>
            <stop offset="1" stop-color="#e0a94e" stop-opacity="0.9"/>
          </linearGradient>
        </defs>
        <!-- tailless pointer: the round-joined stroke curves every corner -->
        <path
          d="M6 2.5 L6 21 L10.5 16.7 L11.8 15.8 L17 15.5 Z"
          fill="url(#cursorFill)"
          stroke="url(#cursorRim)"
          stroke-width="2"
          stroke-linejoin="round"
          stroke-linecap="round"/>
