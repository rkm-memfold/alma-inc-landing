        </button>
        <button class="menubar-extra" type="button" data-menu="wifi" title="Wi-Fi" aria-label="Wi-Fi" aria-haspopup="true" aria-expanded="false">
          <img src="/page/desktop/icons/menu-wifi.png" alt="" width="64" height="46" style="height: 15px">
