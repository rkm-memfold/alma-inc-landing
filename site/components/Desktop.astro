    <div class="prompt-scrim" id="prompt-scrim" hidden>
      <div class="prompt-bar glass" role="dialog" aria-modal="true" aria-label="Ask Alma">
        <div class="prompt-row">
          <img class="prompt-mark" src="/page/desktop/icons/alma.png" alt="" width="192" height="192" decoding="async">
          <input class="prompt-input ph-no-autocapture" id="prompt-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" data-ph-no-autocapture placeholder="Ask Alma to do something&hellip;" aria-label="Ask Alma to do something">
          <span class="prompt-caret" aria-hidden="true"></span>
        </div>
        <ul class="prompt-results" id="prompt-results" role="listbox" aria-label="Results"></ul>
