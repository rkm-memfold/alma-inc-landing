---
import Base from "../../layouts/Base.astro";
import DesktopHead from "../../components/DesktopHead.astro";
import Desktop from "../../components/Desktop.astro";
import Schema from "../../components/Schema.astro";
---

<Base lang="en">
  <Fragment slot="head">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
    <meta name="description" content="Alma on X, Instagram and LinkedIn. Follow along as we build an AI-native computer interface and ship computer-use demos.">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
    <meta name="theme-color" content="#0B0111">
    <link rel="canonical" href="https://alma.inc/socials/">
    <link rel="alternate" type="text/plain" href="https://alma.inc/llms.txt" title="Alma, for language models">

    <meta property="og:title" content="Socials - Follow Alma">
    <meta property="og:description" content="Follow Alma on X, Instagram and LinkedIn.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://alma.inc/socials/">
    <meta property="og:site_name" content="Alma">
    <meta property="og:locale" content="en_US">
    <meta property="og:image" content="https://alma.inc/og-alma-wordmark.png">
    <meta property="og:image:secure_url" content="https://alma.inc/og-alma-wordmark.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Alma, an AI-native computer interface">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@alma_inc">
    <meta name="twitter:title" content="Socials - Follow Alma">
    <meta name="twitter:description" content="Follow Alma on X, Instagram and LinkedIn.">
    <meta name="twitter:image" content="https://alma.inc/og-alma-wordmark.png">
    <meta name="twitter:image:alt" content="Alma, an AI-native computer interface">

    <title>Socials - Follow Alma</title>
    <DesktopHead />
    <Schema page="socials" />
  </Fragment>

  <Desktop open="socials" />
</Base>
