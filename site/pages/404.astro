---
/**
 * The 404 page. Deliberately not the desktop: the shell is 170 KB of markup
 * and a wrong URL does not need it, and a 404 that looks exactly like the
 * homepage tells the visitor nothing. Self-contained, so it costs one request.
 */
import Base from "../layouts/Base.astro";
---

<Base lang="en">
  <Fragment slot="head">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, follow">
    <meta name="theme-color" content="#0B0111">
    <link rel="icon" href="/favicon.png" type="image/png">
    <title>Page not found - Alma</title>
    <style is:inline>
      :root { color-scheme: dark; }
      html, body { height: 100%; }
      body {
        display: grid;
        margin: 0;
        padding: 24px;
        place-content: center;
        justify-items: center;
        gap: 18px;
        background: #0B0111;
        color: rgba(255, 255, 255, 0.92);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        text-align: center;
      }
      /* The white logomark: the dark one is drawn for light surfaces. */
      img { width: 34px; height: 34px; opacity: 0.9; }
      h1 { margin: 0; font-size: 19px; font-weight: 590; letter-spacing: -0.01em; }
      p { max-width: 34ch; margin: 0; color: rgba(255, 255, 255, 0.56); font-size: 14px; line-height: 1.5; }
      a {
        padding: 8px 16px;
        border-radius: 980px;
        background: rgba(255, 255, 255, 0.1);
        color: inherit;
        font-size: 14px;
        text-decoration: none;
      }
      a:hover { background: rgba(255, 255, 255, 0.16); }
    </style>
  </Fragment>

  <img src="/page/desktop/icons/menu-alma.png" alt="Alma" width="96" height="96">
  <h1>This page does not exist.</h1>
  <p>The link may be out of date, or the address may have a typo in it.</p>
  <a href="/">Back to Alma</a>
</Base>
