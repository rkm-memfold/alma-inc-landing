---
import Base from "../layouts/Base.astro";
import DesktopHead from "../components/DesktopHead.astro";
import Desktop from "../components/Desktop.astro";
import Schema from "../components/Schema.astro";
---

<Base lang="en">
  <Fragment slot="head">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
    <meta name="description" content="Alma is an AI-native computer interface for the Mac. Control your computer with natural language and voice, with every action visible and interruptible.">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
    <meta name="theme-color" content="#0B0111">
    <link rel="canonical" href="https://alma.inc/">
    <link rel="alternate" type="text/plain" href="https://alma.inc/llms.txt" title="Alma, for language models">

    <meta property="og:title" content="Alma - The AI-native interface to your computer">
    <meta property="og:description" content="Alma is an AI-native computer interface for the Mac. Control your computer with natural language and voice, across the apps you already use.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://alma.inc/">
    <meta property="og:site_name" content="Alma">
    <meta property="og:locale" content="en_US">
    <meta property="og:image" content="https://alma.inc/og-alma-wordmark.png">
    <meta property="og:image:secure_url" content="https://alma.inc/og-alma-wordmark.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Alma, an AI-native computer interface">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@alma_inc">
    <meta name="twitter:title" content="Alma - The AI-native interface to your computer">
    <meta name="twitter:description" content="Alma is an AI-native computer interface for the Mac. Control your computer with natural language and voice, across the apps you already use.">
    <meta name="twitter:image" content="https://alma.inc/og-alma-wordmark.png">
    <meta name="twitter:image:alt" content="Alma, an AI-native computer interface">

    <title>Alma - The AI-native interface to your computer</title>
    <DesktopHead />
    <Schema page="welcome" />
  </Fragment>

  <Desktop open="welcome" />
</Base>
