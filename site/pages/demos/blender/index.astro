---
import Base from "../../../layouts/Base.astro";
import DesktopHead from "../../../components/DesktopHead.astro";
import Desktop from "../../../components/Desktop.astro";
import Schema from "../../../components/Schema.astro";
---

<Base lang="en">
  <Fragment slot="head">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
    <meta name="description" content="Alma opens Blender on a Mac and models a rocket end to end using computer use, in under two minutes for about $0.30 of inference. Filmed off the screen, uncut.">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
    <meta name="theme-color" content="#0B0111">
    <link rel="canonical" href="https://alma.inc/demos/blender/">
    <link rel="alternate" type="text/plain" href="https://alma.inc/llms.txt" title="Alma, for language models">

    <meta property="og:title" content="Blender demo - Alma builds a rocket with computer use">
    <meta property="og:description" content="Alma builds a rocket in Blender with computer use. Under two minutes, about $0.30.">
    <meta property="og:type" content="video.other">
    <meta property="og:url" content="https://alma.inc/demos/blender/">
    <meta property="og:site_name" content="Alma">
    <meta property="og:locale" content="en_US">
    <meta property="og:image" content="https://alma.inc/page/desktop/demos/blender-poster.jpg">
    <meta property="og:image:secure_url" content="https://alma.inc/page/desktop/demos/blender-poster.jpg">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="960">
    <meta property="og:image:height" content="540">
    <meta property="og:image:alt" content="Alma, an AI-native computer interface">

    <meta name="twitter:card" content="player">
    <meta name="twitter:site" content="@alma_inc">
    <meta name="twitter:title" content="Blender demo - Alma builds a rocket with computer use">
    <meta name="twitter:description" content="Alma builds a rocket in Blender with computer use. Under two minutes, about $0.30.">
    <meta name="twitter:image" content="https://alma.inc/page/desktop/demos/blender-poster.jpg">
    <meta name="twitter:image:alt" content="Alma, an AI-native computer interface">

    <title>Blender demo - Alma builds a rocket with computer use</title>
    <DesktopHead />
    <Schema page="blender" />
  </Fragment>

  <Desktop open="blender" />
</Base>
